# ==============================================================================
# VITOLA — environment variables
# Copy to `.env.local` and fill in. Never commit a filled file.
# ==============================================================================

# --- Age gate (§2) ------------------------------------------------------------
# HMAC key signing the 18+ cookie. At least 32 characters.
# Generate with: openssl rand -base64 48
# In production the application REFUSES TO START without it, by design: an
# unsigned age gate is a decorative one.
AGE_GATE_SECRET=

# --- Supabase (P1) ------------------------------------------------------------
# See docs/setup/supabase.md. Project region: eu-west-3 (Paris).
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...). Safe in the browser: RLS governs it.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...). SERVER ONLY — bypasses RLS entirely.
# Never expose it to the client, never paste it into a conversation, never log it.
SUPABASE_SECRET_KEY=

# --- Claude Code MCP server (development only) --------------------------------
# Read by `.mcp.json`, NOT by the application. These belong in the Claude Code
# environment settings (claude.ai/code -> environment -> variables), not in
# `.env.local`: a remote session has no access to your local file.
#
# Two mistakes cost a full session in August 2026, both silent — the server
# simply fails to load, with no error pointing at the cause:
#   1. the name must be SUPABASE_ACCESS_TOKEN, with two S. `SUPABASE_ACCES_TOKEN`
#      leaves the interpolation in `.mcp.json` empty.
#   2. the ref is the bare `xxxxx` of `https://xxxxx.supabase.co`, NOT the URL.
#      The URL is concatenated into `?project_ref=` and yields a broken address.
#
# Personal access token, account-scoped: it lives here and never in a message.
# Rotate it from the Supabase dashboard the moment it appears in one.
SUPABASE_ACCESS_TOKEN=
# Bare project ref, e.g. abcdefghijklmnopqrst — not a secret, not a URL.
SUPABASE_PROJECT_REF=

# --- Tests --------------------------------------------------------------------
# Optional. Points Playwright at a pre-installed Chromium whose build number
# does not match the pinned @playwright/test (some CI images).
PLAYWRIGHT_CHROMIUM_PATH=

# --- Later phases -------------------------------------------------------------
# ANTHROPIC_API_KEY=        # P4, band recognition. Edge Function only.
# UPSTASH_REDIS_REST_URL=   # P4, scan quota
# UPSTASH_REDIS_REST_TOKEN=
# RESEND_API_KEY=           # P6, transactional e-mail
# STRIPE_SECRET_KEY=        # P7
# STRIPE_WEBHOOK_SECRET=    # P7
# SENTRY_DSN=               # observability, EU region
# NEXT_PUBLIC_POSTHOG_KEY=  # observability, EU cloud (Q20)

# --- The site itself ----------------------------------------------------------
# The origin the site answers on, for the sitemap and `metadataBase`. Without
# it, Next resolves `og:image` against http://localhost:3000 — including in a
# production build, where every link preview would then point at a machine that
# is not the internet. Vercel supplies VERCEL_PROJECT_PRODUCTION_URL as a
# fallback; do not use VERCEL_URL, which is one deployment's host and would put
# a preview's name into a shared card. See lib/site.ts.
NEXT_PUBLIC_SITE_URL=

# Opens indexing: `SITE_INDEXABLE=1` moves robots.txt and the robots meta from
# forbid-everything to exactly the Q13 boundary (the journal and the shop, never
# a tobacco sheet). Closed until Q1 is settled. See lib/site.ts.
SITE_INDEXABLE=

# --- Language (12 September 2026) ---------------------------------------------
# The locale this BUILD serves: `fr` (the default) or `en`. It is not a per-request
# switch and cannot be — 116 files read the dictionary at module scope, and Next 16
# has no synchronous request context to read a cookie from during a render. So the
# English site is its own build, served from its own domain:
#
#   NEXT_PUBLIC_LOCALE=en pnpm build
#
# `NEXT_PUBLIC_` is deliberate: the value is inlined at build time, so the server
# and the browser cannot disagree about it. An unrecognised value FAILS the build
# (next.config.ts) rather than falling back silently. See docs/adr/0019.
NEXT_PUBLIC_LOCALE=
